# Copy to .env.local and fill in real values from your Supabase project.
#
# Supabase key terminology:
#   - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is safe for the browser. It is used
#     for user-session clients (subject to Row Level Security) and replaces the
#     legacy "anon" key.
#   - SUPABASE_SECRET_KEY is a server-only privileged key that bypasses RLS.
#     It replaces the legacy "service role" key. Never expose it to the
#     browser or to client-side code. It is not used by the SSR clients yet;
#     it is reserved for server-side work such as Trigger.dev jobs and admin
#     tasks.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
#
# Trigger.dev (background job runner) — used by the Website Audit Engine.
#   - TRIGGER_SECRET_KEY is read by the @trigger.dev/sdk inside the Next.js app
#     when calling tasks.trigger(). Server-only; never expose it to the browser.
#   - TRIGGER_PROJECT_REF is the project ref from your Trigger.dev dashboard. It
#     is read by trigger.config.ts (only the Trigger.dev CLI evaluates that file),
#     so it is NOT needed for next dev / next build.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=